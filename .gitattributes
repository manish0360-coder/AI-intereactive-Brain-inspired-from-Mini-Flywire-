research/preregistrations/UQA_PREREGISTRATION.sha256  -text

# UQ-A EVIDENCE ARTIFACTS — the same byte-integrity guarantee, extended from the
# pre-registration to the evidence it governs.
#
# uqa_results.sha256, uqa_liveness.json's INTEGRITY.sha256 and data/INTEGRITY.sha256
# identify their artifacts by a SHA-256 over exact bytes. With core.autocrlf=true
# and no attribute, git rewrites LF to CRLF on checkout and every one of those
# digests fails on a fresh clone. Demonstrated, not assumed: checking the blobs
# out through the smudge filter reproduces the claimed digest only for paths
# carrying `-text`.
#
# This modifies no frozen document, threshold, seed range, acceptance criterion
# or item of evidence. It only stops git from rewriting bytes whose exactness is
# the whole integrity claim.
#
# NOTE — the same exposure exists for the M8, M9 and Q1 data artifacts and is
# NOT repaired here: those belong to closed milestones and their repair is a
# separate governance decision, not something to fold silently into this commit.
experiments/uqa/data/*.jsonl        -text
experiments/uqa/data/INTEGRITY.sha256 -text
experiments/uqa/results/*.json      -text
experiments/uqa/results/*.sha256    -text

# UQ-B pre-registration — same byte-integrity guarantee as the M7, M8, M9, Q1 and
# UQ-A frozen artifacts. Its identity is a SHA-256 over exact bytes
# (UQB_PREREGISTRATION.sha256), so end-of-line conversion must be disabled in both
# directions or the digest fails to validate on checkout.
research/preregistrations/UQB_PREREGISTRATION.md      -text
research/preregistrations/UQB_PREREGISTRATION.sha256  -text

# UQ-B liveness evidence — the same byte-integrity guarantee as the UQ-A evidence
# artifacts. INTEGRITY.sha256 identifies uqb_liveness.json by a SHA-256 over exact
# bytes; without `-text` an end-of-line-converting checkout breaks that digest on a
# fresh clone.
experiments/uqb/results/*.json      -text
experiments/uqb/results/*.sha256    -text
# The instrument-generalization stress gate records its evidence as a text log,
# which the two patterns above do not cover. Without `-text` uqb_stress.sha256
# would fail on any end-of-line-converting checkout.
experiments/uqb/results/*.txt       -text

# UQ-B errata — the same byte-integrity guarantee as the UQ-B pre-registration
# they bind to. Each erratum quotes the frozen digest and supersedes a clause by
# reference, so the supersession record must be reproducible with the same
# fidelity as the document it amends.
research/preregistrations/UQB_PREREGISTRATION_ERRATUM_*.md     -text
research/preregistrations/UQB_PREREGISTRATION_ERRATUM_*.sha256 -text

# UQ-B collection evidence — the same byte-integrity guarantee as UQ-A's.
experiments/uqb/data/*.jsonl        -text
experiments/uqb/data/INTEGRITY.sha256 -text

